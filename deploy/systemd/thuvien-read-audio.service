[Unit]
Description=Thuvien R2 reading audio gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=eagles
Group=eagles
WorkingDirectory=/home/eagles/dockerz/efast-copy
EnvironmentFile=/home/eagles/dockerz/efast-copy/.env
Environment=R2_AUDIO_MANIFEST=/home/eagles/dockerz/efast-copy/poc/r2-read-audio-all.json
Environment=R2_AUDIO_PORT=8789
ExecStart=/home/eagles/.nvm/versions/node/v22.22.1/bin/node /home/eagles/dockerz/efast-copy/scripts/r2-read-audio-gateway.cjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
